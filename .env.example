# AI Agent Configuration Example
# Copy to .env and fill in real values.

GOOGLE_API_KEY=your-api-key-here

# Secure-by-default runtime controls
# Comma-separated allowlist for file operation roots (default is project root).
# AI_AGENT_ALLOWED_ROOTS=/absolute/path/one,/absolute/path/two

# Keep open_item disabled unless interactive app launching is required.
AI_AGENT_ENABLE_OPEN_ITEM=false

# Keep raw prompts out of audit logs unless explicitly needed.
AI_AGENT_AUDIT_INCLUDE_PROMPT=false

# Keep TLS verification enabled by default.
# Only for local debugging with trusted endpoints:
# AI_AGENT_ALLOW_INSECURE_TLS=true

# Automation scripts run with a minimal environment by default.
# Optional comma-separated passthrough environment names:
# AI_AGENT_AUTOMATION_ENV_ALLOWLIST=MY_VAR,ANOTHER_VAR

# Privacy / compliance (fail closed)
AI_AGENT_REQUIRE_NO_TRAINING=false

# Vertex AI backend (required when no-training is enforced)
AI_AGENT_USE_VERTEXAI=false
AI_AGENT_VERTEX_PROJECT=your-gcp-project-id
AI_AGENT_VERTEX_LOCATION=us-central1

# Optional compatibility aliases used by some SDK/GCP tooling
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: strict package hash pinning for unified-planning.
# Supports comma-separated SHA-256 digests for safe version rotation windows.
# Example format:
# AI_AGENT_UNIFIED_PLANNING_HASH_PIN=<current_digest>,<next_digest>
AI_AGENT_UNIFIED_PLANNING_HASH_PIN=

# Enable secure auto-rotation of trusted hashes using an HMAC-signed local store.
# Requires:
# - AI_AGENT_UNIFIED_PLANNING_HASH_PIN_AUTO_ROTATE=true
# - AI_AGENT_UNIFIED_PLANNING_HASH_PIN_STORE_HMAC_KEY=<strong-secret>
# Optional:
# - AI_AGENT_UNIFIED_PLANNING_HASH_PIN_STORE=~/.local/share/ai-agent/security/unified_planning_hash_store.json
# - AI_AGENT_UNIFIED_PLANNING_HASH_PIN_MAX_HISTORY=6
AI_AGENT_UNIFIED_PLANNING_HASH_PIN_AUTO_ROTATE=false
AI_AGENT_UNIFIED_PLANNING_HASH_PIN_STORE_HMAC_KEY=
# AI_AGENT_UNIFIED_PLANNING_HASH_PIN_STORE=
# AI_AGENT_UNIFIED_PLANNING_HASH_PIN_MAX_HISTORY=6

# Plan mode planner-first enforcement for actionable file operations.
# Number of discovery tool calls allowed before planner/plan_ops is required.
# Clamped to 0..8 by runtime.
AI_AGENT_PLAN_MODE_DISCOVERY_BEFORE_PLANNER=2

# Plan mode clarification loop.
# When true, plan mode asks clarifying questions before planning if requirements
# are underspecified, instead of guessing.
AI_AGENT_PLAN_MODE_CLARIFICATION_REQUIRED=true
